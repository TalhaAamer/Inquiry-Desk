{
  "services": {
    "web": { "root": "frontend/" },
    "api": {
      "root": "backend/",
      "entrypoint": "main:app",
      "functions": { "main.py": { "maxDuration": 60 } }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
